  {
    "question": "Failed logins from outside the corporate network in the last 30 days",
    "explanation": "Authentication failures whose source IP is not in 10.0.0.0/8. CIDR is filtered after fetch where an engine cannot evaluate it.",
    "ir": {
      "dataset": "authentication",
      "time": {
        "from": "now-30d"
      },
      "where": {
        "and": [
          {
            "cmp": {
              "field": "status_id",
              "op": "eq",
              "value": 2
            }
          },
          {
            "not": {
              "cmp": {
                "field": "src_endpoint.ip",
                "op": "cidr",
                "value": "10.0.0.0/8"
              }
            }
          }
        ]
      },
      "limit": 200
    }
  },
  {
