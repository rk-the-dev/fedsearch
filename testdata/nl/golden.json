[
  {
    "question": "Show failed logins for svc_backup in the last 6 months",
    "aliases": [
      "failed logins for svc_backup",
      "svc_backup failed logins last 6 months"
    ],
    "demo": true,
    "explanation": "Authentication events for user svc_backup with status Failure (status_id 2) over the last 180 days, across both tiers.",
    "ir": {
      "dataset": "authentication",
      "time": {
        "from": "now-180d",
        "to": "now"
      },
      "where": {
        "and": [
          {
            "cmp": {
              "field": "user.name",
              "op": "eq",
              "value": "svc_backup"
            }
          },
          {
            "cmp": {
              "field": "status_id",
              "op": "eq",
              "value": 2
            }
          }
        ]
      },
      "select": [
        "time",
        "user.name",
        "src_endpoint.ip",
        "dst_endpoint.hostname",
        "status_id",
        "auth_protocol",
        "http_request.user_agent"
      ],
      "limit": 200
    }
  },
  {
    "question": "How many failed logins did svc_backup have in the last 6 months?",
    "aliases": [
      "count failed logins for svc_backup"
    ],
    "demo": true,
    "explanation": "Counts svc_backup authentication failures over 180 days; the overlap window between tiers is counted once.",
    "ir": {
      "dataset": "authentication",
      "time": {
        "from": "now-180d"
      },
      "where": {
        "and": [
          {
            "cmp": {
              "field": "user.name",
              "op": "eq",
              "value": "svc_backup"
            }
          },
          {
            "cmp": {
              "field": "status_id",
              "op": "eq",
              "value": 2
            }
          }
        ]
      },
      "aggs": [
        {
          "fn": "count",
          "as": "failures"
        }
      ]
    }
  },
  {
    "question": "Which accounts had the most failed logins in the last 30 days?",
    "explanation": "Groups authentication failures by user name and ranks by count.",
    "ir": {
      "dataset": "authentication",
      "time": {
        "from": "now-30d"
      },
      "where": {
        "cmp": {
          "field": "status_id",
          "op": "eq",
          "value": 2
        }
      },
      "group_by": [
        "user.name"
      ],
      "aggs": [
        {
          "fn": "count",
          "as": "failures"
        }
      ],
      "order": {
        "by": "failures",
        "desc": true
      },
      "limit": 10
    }
  },
