  {
    "question": "Show all network activity involving 185.220.101.47 in the last 6 months",
    "aliases": [
      "traffic to or from 185.220.101.47"
    ],
    "demo": true,
    "explanation": "Network events where 185.220.101.47 is the source or the destination, across both tiers.",
    "ir": {
      "dataset": "network_activity",
      "time": {
        "from": "now-180d"
      },
      "where": {
        "or": [
          {
            "cmp": {
              "field": "src_endpoint.ip",
              "op": "eq",
              "value": "185.220.101.47"
            }
          },
          {
            "cmp": {
              "field": "dst_endpoint.ip",
              "op": "eq",
              "value": "185.220.101.47"
            }
          }
        ]
      },
      "enrich": [
        "src_endpoint.ip",
        "dst_endpoint.ip"
      ],
      "limit": 1000
    }
  },
  {
    "question": "How much data was sent to 185.220.101.47 in the last 6 months, by source?",
    "aliases": [
      "data sent to 185.220.101.47"
    ],
    "demo": true,
    "explanation": "Sums outbound bytes to 185.220.101.47 per source IP.",
    "ir": {
      "dataset": "network_activity",
      "time": {
        "from": "now-180d"
      },
      "where": {
        "cmp": {
          "field": "dst_endpoint.ip",
          "op": "eq",
          "value": "185.220.101.47"
        }
      },
      "group_by": [
        "src_endpoint.ip"
      ],
      "aggs": [
        {
          "fn": "sum",
          "field": "traffic.bytes_out",
          "as": "bytes_out"
        },
        {
          "fn": "count",
          "as": "flows"
        }
      ],
      "order": {
        "by": "bytes_out",
        "desc": true
      },
      "limit": 10
    }
  },
  {
    "question": "Blocked connections by destination port in the last 90 days",
